///Cita.kt

package com.ucsm.recuperacitas.data

import androidx.room.Entity
import androidx.room.PrimaryKey

@Entity(tableName = "citas")
data class Cita(
    @PrimaryKey(autoGenerate = true)
    val id: Int = 0,
    val especialista: String,
    val descripcion: String,
    val fecha: String,
    val estado: String
)


///CitaDao.kt

package com.ucsm.recuperacitas.data

import androidx.room.Dao
import androidx.room.Insert
import androidx.room.OnConflictStrategy
import androidx.room.Query
import androidx.room.Update

@Dao
interface CitaDao {

    @Insert(onConflict = OnConflictStrategy.ABORT)
    suspend fun insertar(cita: Cita): Long

    @Update
    suspend fun actualizar(cita: Cita): Int

    @Query("DELETE FROM citas WHERE id = :id")
    suspend fun eliminarPorId(id: Int): Int

    @Query("SELECT * FROM citas WHERE id = :id LIMIT 1")
    suspend fun buscarPorId(id: Int): Cita?

    @Query("SELECT * FROM citas ORDER BY id ASC")
    suspend fun listarTodos(): List<Cita>
}


///AppDatabase.kt

package com.ucsm.recuperacitas.data

import android.content.Context
import androidx.room.Database
import androidx.room.Room
import androidx.room.RoomDatabase

@Database(
    entities = [Cita::class],
    version = 1,
    exportSchema = false
)
abstract class AppDatabase : RoomDatabase() {
    abstract fun citaDao(): CitaDao

    companion object {
        @Volatile
        private var INSTANCE: AppDatabase? = null

        fun getInstance(context: Context): AppDatabase {
            return INSTANCE ?: synchronized(this) {
                val instance = Room.databaseBuilder(
                    context.applicationContext,
                    AppDatabase::class.java,
                    "recupera.db"
                )
                    .fallbackToDestructiveMigration()
                    .build()
                INSTANCE = instance
                instance
            }
        }
    }
}


