
///activity_main.xml

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/textInputLayout"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/ingresa">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/save" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLoad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/load" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveExt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:backgroundTint="#FF6600"
        android:text="@string/save_ext" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLoadExt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="#FF6600"
        android:text="@string/load_ext" />

</LinearLayout>

  ///MainActivity.kt

  package com.ucsm.archivointerno

import android.content.Context
import android.os.Bundle
import android.widget.Toast
import androidx.appcompat.app.AppCompatActivity
import com.ucsm.archivointerno.databinding.ActivityMainBinding
import java.io.File

class MainActivity : AppCompatActivity() {

    private lateinit var binding: ActivityMainBinding

    companion object {
        private const val FILE_NAME = "textfile.txt"
        private const val FILE_NAME_EXT = "textfile_externo.txt"
    }

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        binding = ActivityMainBinding.inflate(layoutInflater)
        setContentView(binding.root)

        binding.btnSave.setOnClickListener { onClickSave() }
        binding.btnLoad.setOnClickListener { onClickLoad() }
        binding.btnSaveExt.setOnClickListener { onClickSaveExterno() }
        binding.btnLoadExt.setOnClickListener { onClickLoadExterno() }
    }

    // ── ALMACENAMIENTO INTERNO ──────────────────────────────

    private fun onClickSave() {
        val texto = binding.editText.text.toString()
        try {
            openFileOutput(FILE_NAME, Context.MODE_PRIVATE).use { fos ->
                fos.write(texto.toByteArray())
            }
            Toast.makeText(this, "Archivo interno guardado!", Toast.LENGTH_SHORT).show()
            binding.editText.setText("")
        } catch (e: Exception) {
            e.printStackTrace()
            Toast.makeText(this, "Error al guardar: ${e.message}", Toast.LENGTH_SHORT).show()
        }
    }

    private fun onClickLoad() {
        try {
            val contenido = openFileInput(FILE_NAME).bufferedReader().use { it.readText() }
            binding.editText.setText(contenido)
            Toast.makeText(this, "Archivo interno cargado!", Toast.LENGTH_SHORT).show()
        } catch (e: java.io.FileNotFoundException) {
            Toast.makeText(this, "El archivo no existe aún", Toast.LENGTH_SHORT).show()
        } catch (e: Exception) {
            e.printStackTrace()
            Toast.makeText(this, "Error al cargar: ${e.message}", Toast.LENGTH_SHORT).show()
        }
    }

    // ── ALMACENAMIENTO EXTERNO (Scoped Storage) ─────────────

    private fun onClickSaveExterno() {
        val texto = binding.editText.text.toString()
        try {
            // getExternalFilesDir() no requiere permisos en Android 10+
            val directorio = getExternalFilesDir(null)
            val archivo = File(directorio, FILE_NAME_EXT)
            archivo.writeText(texto)
            Toast.makeText(
                this,
                "Archivo externo guardado en: ${archivo.absolutePath}",
                Toast.LENGTH_LONG
            ).show()
            binding.editText.setText("")
        } catch (e: Exception) {
            e.printStackTrace()
            Toast.makeText(this, "Error al guardar externo: ${e.message}", Toast.LENGTH_SHORT).show()
        }
    }

    private fun onClickLoadExterno() {
        try {
            val directorio = getExternalFilesDir(null)
            val archivo = File(directorio, FILE_NAME_EXT)
            val contenido = archivo.readText()
            binding.editText.setText(contenido)
            Toast.makeText(this, "Archivo externo cargado!", Toast.LENGTH_SHORT).show()
        } catch (e: java.io.FileNotFoundException) {
            Toast.makeText(this, "El archivo externo no existe aún", Toast.LENGTH_SHORT).show()
        } catch (e: Exception) {
            e.printStackTrace()
            Toast.makeText(this, "Error al cargar externo: ${e.message}", Toast.LENGTH_SHORT).show()
        }
    }
}


////strings.xml

<resources>
    <string name="app_name">ArchivoInterno</string>
    <string name="ingresa">Ingresa algún texto</string>
    <string name="save">Guardar Fichero</string>
    <string name="load">Cargar Fichero</string>
    <string name="save_ext">Guardar Externo</string>
    <string name="load_ext">Cargar Externo</string>
</resources>

