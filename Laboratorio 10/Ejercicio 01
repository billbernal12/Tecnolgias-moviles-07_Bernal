import 'package:flutter/material.dart';
import 'dart:math'; 

void main() {
  runApp(const MyApp());
}

// Widget raiz de la aplicacion
class MyApp extends StatelessWidget {
  const MyApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      title: 'Calculadora',
      debugShowCheckedModeBanner: false,
      theme: ThemeData(
        colorScheme: ColorScheme.fromSeed(seedColor: Colors.deepPurple),
        useMaterial3: true,
      ),
      home: const CalculadoraScreen(),
    );
  }
}

//Pantalla principal 
class CalculadoraScreen extends StatefulWidget {
  const CalculadoraScreen({super.key});

  @override
  State<CalculadoraScreen> createState() => _CalculadoraScreenState();
}

class _CalculadoraScreenState extends State<CalculadoraScreen> {
  // Controladores para capturar texto de los campos
  final TextEditingController _num1Controller = TextEditingController();
  final TextEditingController _num2Controller = TextEditingController();

  String _resultado = ''; // Almacena el resultado a mostrar

  // Funcion principal
  void _calcular(String operacion) {
    final double? num1 = double.tryParse(_num1Controller.text);
    final double? num2 = double.tryParse(_num2Controller.text);

    // Validacion
    if (num1 == null) {
      setState(() => _resultado = '⚠️ Ingrese un número válido en el campo 1');
      return;
    }

    setState(() {
      switch (operacion) {
        case 'suma':
          if (num2 == null) { _resultado = '⚠️ Ingrese el segundo número'; return; }
          _resultado = '${num1} + ${num2} = ${num1 + num2}';
          break;

        case 'resta':
          if (num2 == null) { _resultado = '⚠️ Ingrese el segundo número'; return; }
          _resultado = '${num1} - ${num2} = ${num1 - num2}';
          break;

        case 'multiplicacion':
          if (num2 == null) { _resultado = '⚠️ Ingrese el segundo número'; return; }
          _resultado = '${num1} × ${num2} = ${num1 * num2}';
          break;

        case 'division':
          if (num2 == null) { _resultado = '⚠️ Ingrese el segundo número'; return; }
          if (num2 == 0)    { _resultado = '❌ Error: No se puede dividir entre 0'; return; }
          _resultado = '${num1} ÷ ${num2} = ${num1 / num2}';
          break;

        case 'potencia':
          if (num2 == null) { _resultado = '⚠️ Ingrese el exponente en el campo 2'; return; }
          _resultado = '${num1} ^ ${num2} = ${pow(num1, num2)}';
          break;

        case 'raiz':
          if (num1 < 0) { _resultado = '❌ Error: Raíz de número negativo'; return; }
          _resultado = '√${num1} = ${sqrt(num1).toStringAsFixed(4)}';
          break;
      }
    });
  }

  // Helper: boton de operacion 
  Widget _boton(String label, String operacion, Color color) {
    return ElevatedButton(
      style: ElevatedButton.styleFrom(
        backgroundColor: color,
        foregroundColor: Colors.white,
        padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 14),
        shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(10)),
      ),
      onPressed: () => _calcular(operacion),
      child: Text(label, style: const TextStyle(fontSize: 15, fontWeight: FontWeight.bold)),
    );
  }

  // UI 
  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: const Color(0xFFF3F0FF),
      appBar: AppBar(
        title: const Text('Calculadora Flutter',
            style: TextStyle(color: Colors.white, fontWeight: FontWeight.bold)),
        backgroundColor: Colors.deepPurple,
        centerTitle: true,
      ),
      body: SingleChildScrollView(
        padding: const EdgeInsets.all(20),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.stretch,
          children: [
            // Campo Numero 1 
            TextField(
              controller: _num1Controller,
              keyboardType: const TextInputType.numberWithOptions(decimal: true, signed: true),
              decoration: InputDecoration(
                labelText: 'Número 1',
                prefixIcon: const Icon(Icons.looks_one, color: Colors.deepPurple),
                border: OutlineInputBorder(borderRadius: BorderRadius.circular(10)),
                filled: true,
                fillColor: Colors.white,
              ),
            ),
            const SizedBox(height: 14),

            // Campo Numero 2
            TextField(
              controller: _num2Controller,
              keyboardType: const TextInputType.numberWithOptions(decimal: true, signed: true),
              decoration: InputDecoration(
                labelText: 'Número 2  (no se usa en raíz √)',
                prefixIcon: const Icon(Icons.looks_two, color: Colors.deepPurple),
                border: OutlineInputBorder(borderRadius: BorderRadius.circular(10)),
                filled: true,
                fillColor: Colors.white,
              ),
            ),
            const SizedBox(height: 24),

            //Botones de operaciones
            const Text('Selecciona una operación:',
                style: TextStyle(fontWeight: FontWeight.bold, fontSize: 15)),
            const SizedBox(height: 12),

            Wrap(
              spacing: 10,
              runSpacing: 10,
              alignment: WrapAlignment.center,
              children: [
                _boton('➕ Suma',           'suma',           Colors.green.shade600),
                _boton('➖ Resta',          'resta',           Colors.orange.shade700),
                _boton('✖️ Multiplicación', 'multiplicacion',  Colors.blue.shade700),
                _boton('➗ División',       'division',        Colors.red.shade600),
                _boton('^ Potencia',        'potencia',        Colors.purple.shade700),
                _boton('√ Raíz',           'raiz',            Colors.teal.shade600),
              ],
            ),
            const SizedBox(height: 30),

            // Resultado
            if (_resultado.isNotEmpty)
              Container(
                padding: const EdgeInsets.all(20),
                decoration: BoxDecoration(
                  color: Colors.white,
                  borderRadius: BorderRadius.circular(12),
                  border: Border.all(color: Colors.deepPurple, width: 2),
                  boxShadow: [
                    BoxShadow(color: Colors.deepPurple.withOpacity(0.15),
                        blurRadius: 8, offset: const Offset(0, 4))
                  ],
                ),
                child: Text(
                  _resultado,
                  textAlign: TextAlign.center,
                  style: const TextStyle(
                    fontSize: 22,
                    fontWeight: FontWeight.bold,
                    color: Colors.deepPurple,
                  ),
                ),
              ),
          ],
        ),
      ),
    );
  }
}
